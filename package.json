{
  "name": "remember-api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "dev": "node --env-file-if-exists=.env --watch src/server.ts",
    "start": "node --env-file-if-exists=.env src/server.ts",
    "migrate": "node --env-file-if-exists=.env scripts/migrate.ts",
    "storage:check": "node --env-file-if-exists=.env scripts/storage-check.ts",
    "pretest": "npm run migrate",
    "test": "node --env-file-if-exists=.env node_modules/vitest/vitest.mjs run",
    "lint": "biome check",
    "format": "biome format --write",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "aws4fetch": "^1.0.20",
    "fastify": "^5.12.1",
    "jose": "^6.2.10",
    "nodemailer": "^10.0.10",
    "postgrator": "^8.0.0",
    "postgres": "^3.4.9"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.11",
    "@types/mailparser": "^3.4.6",
    "@types/node": "^24.0.0",
    "@types/smtp-server": "^3.5.13",
    "mailparser": "^3.9.28",
    "smtp-server": "^3.19.13",
    "typescript": "^5.9.0",
    "vitest": "^4.1.11"
  }
}
