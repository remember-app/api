{
  "name": "remember-api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "dev": "node --env-file-if-exists=.env --watch src/server.ts",
    "start": "node --env-file-if-exists=.env src/server.ts",
    "migrate": "node --env-file-if-exists=.env scripts/cicd/migrate.ts",
    "seed:essentials": "node --env-file-if-exists=.env scripts/cicd/seed-essentials.ts",
    "seed:test": "node --env-file-if-exists=.env scripts/manual/seed-test.ts",
    "lint": "biome check",
    "format": "biome format --write",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "aws4fetch": "^1.0.20",
    "fastify": "^5.12.1",
    "nodemailer": "^10.0.10",
    "postgrator": "^8.0.0",
    "postgres": "^3.4.9"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.11",
    "@types/node": "^24.0.0",
    "typescript": "^5.9.0"
  }
}
