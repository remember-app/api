POSTGRES_URL=postgres://postgres:postgres@localhost:5432/remember
PORT=3000

# Боевой режим. В боевом окружении задать обязательно.
# NODE_ENV=production

# Вход рецензента Apple: один адрес входит по постоянному коду, без письма, и в
# боевом режиме тоже. Одна строка
# «адрес:код» — адрес строчными, код из шести цифр. Не задана или пустая —
# двери нет; задана криво — сервер не стартует. Значение — секрет: в репозиторий
# не класть, в бою оно лежит с остальными секретами инфраструктуры.
# REVIEW_LOGIN=

# Вход без почты для разработки: шесть цифр. Работает только когда
# NODE_ENV не production; для любого адреса код возвращается в ответе.
# EMAIL_LOGIN_DEV_BYPASS=123456

# Объектное хранилище, S3-совместимое. Локально это MinIO из docker-compose.
# Без всех четырёх загрузка отвечает 503.
S3_ENDPOINT=http://localhost:9000
S3_BUCKET=remember
S3_ACCESS_KEY_ID=remember
S3_SECRET_ACCESS_KEY=remember-secret
# Адрес, который попадает в подписанные ссылки. Не задан — берётся S3_ENDPOINT.
# Локально в контейнере S3_ENDPOINT указывает на s3:9000, а ссылки для телефона —
# на localhost:9000.
# S3_PUBLIC_ENDPOINT=http://localhost:9000

# Почта: код входа уходит письмом по SMTP. Ящик и пароль заводит человек, в
# коде и в репозитории их нет. Не задан хотя бы один из SMTP_HOST, SMTP_USER,
# SMTP_PASSWORD, SMTP_FROM (или пустой — это та же опечатка) — почты нет:
# сервис поднимается штатно, а POST /auth/email/start отвечает 503.
# SMTP_SECURE=false — шифрование включается после соединения (STARTTLS, порт
# 587); true — соединение шифруется сразу (порт 465). Порт по умолчанию
# следует за ним, а на 465 соединение шифруется сразу в любом случае. У Gmail
# пароль — пароль приложения, а SMTP_FROM — сам ящик SMTP_USER или его
# подтверждённый псевдоним.
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_FROM=Remember <no-reply@example.com>

# Defaults, listed so they are findable. Nothing here is required to boot.
# SESSION_TTL_DAYS=365
# EMAIL_LOGIN_TTL_MINUTES=15

# Сколько раз можно ошибиться кодом, прежде чем он умрёт — умрёт совсем, даже
# для верных цифр, и нужно будет запросить новый. Код из шести цифр — это один
# миллион вариантов, поэтому перебор ограничивают вдвоём: этот потолок и
# EMAIL_LOGIN_RATE_MAX (сколько кодов вообще можно запросить за окно). Двигать
# их имеет смысл только вместе — злоумышленнику достаётся их произведение.
# EMAIL_LOGIN_MAX_ATTEMPTS=5

# EMAIL_LOGIN_RATE_MAX=5
# EMAIL_LOGIN_RATE_MAX_PER_IP=50
# EMAIL_LOGIN_RATE_WINDOW_MINUTES=15

# S3_REGION=auto
# MEDIA_UPLOAD_TTL_SECONDS=3600
# MEDIA_DOWNLOAD_TTL_SECONDS=900
# MEDIA_UPLOAD_PART_BYTES=8388608

# Лимиты из architecture.md. 1 ГиБ на файл, видео 5 минут, 10 ГиБ и 1000 файлов
# на воспоминание.
# MEDIA_MAX_FILE_BYTES=1073741824
# MEDIA_MAX_VIDEO_SECONDS=300
# PROJECT_MAX_STORAGE_BYTES=10737418240
# PROJECT_MAX_FILES=1000

# Ролик: длина, если заказчик её не назвал. Границы не настраиваются — предел
# считается по материалу воспоминания (см. README, «Заказ ролика»).
# MONTAGE_TARGET_SECONDS=60

# Общий секрет, которым montage-воркер стучится в POST /internal/montages/:id/ready.
# Придумывает человек, значение должно совпадать у api и у воркера. Не задан (или
# пустой) — маршрут закрыт для всех, любой стук получает 401, и пуш «ролик готов»
# не уходит.
# INTERNAL_WORKER_TOKEN=
