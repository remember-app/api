DATABASE_URL=postgres://remember:remember@localhost:5432/remember
PORT=3000

# Объектное хранилище: локально это MinIO из docker-compose, в проде —
# Cloudflare R2 (тот же S3-протокол, значения подставляются другие).
# Без всех четырёх загрузка отвечает 503.
R2_ENDPOINT=http://localhost:9000
R2_BUCKET=remember
R2_ACCESS_KEY_ID=remember
R2_SECRET_ACCESS_KEY=remember-secret

# Почта: ссылка входа уходит письмом через Resend (обычный HTTP-запрос, без
# SDK). Ключ и адрес отправителя заводит человек, в коде их нет. Не заданы (или
# пустые — это та же опечатка) — почты нет: сервис поднимается штатно, а
# POST /auth/email/start отвечает 503.
# RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxx
# MAIL_FROM=Remember <no-reply@example.com>

# Куда уходит письмо. Переопределяется затем же, зачем EXPO_PUSH_URL: чтобы
# тесты целились в свой хост, а не в настоящий API.
# RESEND_API_URL=https://api.resend.com/emails

# Defaults, listed so they are findable. Nothing here is required to boot.
# SESSION_TTL_DAYS=30
# EMAIL_LOGIN_TTL_MINUTES=15
# EMAIL_LOGIN_RATE_MAX=5
# EMAIL_LOGIN_RATE_MAX_PER_IP=50
# EMAIL_LOGIN_RATE_WINDOW_MINUTES=15

# R2_REGION=auto
# R2_UPLOAD_TTL_SECONDS=3600
# R2_DOWNLOAD_TTL_SECONDS=900
# MEDIA_UPLOAD_PART_BYTES=8388608

# Лимиты из architecture.md. 1 ГиБ на файл, видео 5 минут, 10 ГиБ и 1000 файлов
# на воспоминание.
# MEDIA_MAX_FILE_BYTES=1073741824
# MEDIA_MAX_VIDEO_SECONDS=300
# MEMORY_MAX_STORAGE_BYTES=10737418240
# MEMORY_MAX_FILES=1000

# Где лежит schema.sql соседнего montage — оттуда берётся таблица jobs.
# По умолчанию ../montage/schema.sql, то есть сабмодуль рядом.
# MONTAGE_SCHEMA_SQL=../montage/schema.sql

# Our client ids at Apple and Google — the `aud` an id token must carry.
# Unset means the provider is off: /auth/apple and /auth/google answer 501.
# APPLE_CLIENT_ID=com.example.remember
# GOOGLE_CLIENT_ID=000000000000-xxxxxxxx.apps.googleusercontent.com
