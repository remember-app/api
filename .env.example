DATABASE_URL=postgres://postgres:postgres@localhost:5432/remember
PORT=3000

# Боевой режим. В боевом окружении задать обязательно: он запрещает обход почты
# на POST /auth/email/start при любых других настройках.
# NODE_ENV=production

# Обход почты для разработки. Задан («1» или «true», регистр не важен) — POST
# /auth/email/start отдаёт код входа прямо в ответе, без письма, и только для
# адресов на домене test.test (зона .test зарезервирована RFC 2606 навсегда,
# почты там не будет ни у кого); всем остальным уходит письмо (или 503, если
# почты нет). Не задан — обхода нет вовсе, что бы ни стояло в NODE_ENV и есть
# ли настройки почты. Любое другое значение («0», «no», пустое) — тоже «выключено»:
# эта переменная единственная, что открывает дверь, поэтому непонятое значение
# оставляет её закрытой. В боевом окружении не задавать никогда.
# EMAIL_LOGIN_DEV_BYPASS=1

# Объектное хранилище: локально это MinIO из docker-compose, в проде —
# Cloudflare R2 (тот же S3-протокол, значения подставляются другие).
# Без всех четырёх загрузка отвечает 503.
R2_ENDPOINT=http://localhost:9000
R2_BUCKET=remember
R2_ACCESS_KEY_ID=remember
R2_SECRET_ACCESS_KEY=remember-secret

# Почта: код входа уходит письмом по SMTP. Ящик и пароль заводит человек, в
# коде и в репозитории их нет. Не задан хотя бы один из SMTP_HOST, SMTP_USER,
# SMTP_PASSWORD, MAIL_FROM (или пустой — это та же опечатка) — почты нет:
# сервис поднимается штатно, а POST /auth/email/start отвечает 503.
# SMTP_SECURE=false — шифрование включается после соединения (STARTTLS, порт
# 587); true — соединение шифруется сразу (порт 465). Порт по умолчанию
# следует за ним. У Gmail пароль — пароль приложения, а MAIL_FROM — сам ящик
# SMTP_USER или его подтверждённый псевдоним.
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASSWORD=
# MAIL_FROM=Remember <no-reply@example.com>

# Defaults, listed so they are findable. Nothing here is required to boot.
# SESSION_TTL_DAYS=30
# EMAIL_LOGIN_TTL_MINUTES=15

# Сколько раз можно ошибиться кодом, прежде чем он умрёт — умрёт совсем, даже
# для верных цифр, и нужно будет запросить новый. Код из шести цифр — это один
# миллион вариантов, поэтому перебор ограничивают вдвоём: этот потолок и
# EMAIL_LOGIN_RATE_MAX (сколько кодов вообще можно запросить за окно). Двигать
# их имеет смысл только вместе — злоумышленнику достаётся их произведение.
# EMAIL_LOGIN_MAX_ATTEMPTS=5

# EMAIL_LOGIN_RATE_MAX=5
# EMAIL_LOGIN_RATE_MAX_PER_IP=50
# EMAIL_LOGIN_RATE_WINDOW_MINUTES=15

# R2_REGION=auto
# R2_UPLOAD_TTL_SECONDS=3600
# R2_DOWNLOAD_TTL_SECONDS=900
# MEDIA_UPLOAD_PART_BYTES=8388608

# Лимиты из architecture.md. 1 ГиБ на файл, видео 5 минут, 10 ГиБ и 1000 файлов
# на воспоминание.
# MEDIA_MAX_FILE_BYTES=1073741824
# MEDIA_MAX_VIDEO_SECONDS=300
# MEMORY_MAX_STORAGE_BYTES=10737418240
# MEMORY_MAX_FILES=1000

# Ролик: длина, если заказчик её не назвал. Границы не настраиваются — предел
# считается по материалу воспоминания (см. README, «Заказ ролика»).
# MONTAGE_TARGET_SECONDS=60

# Общий секрет, которым montage-воркер стучится в POST /internal/montages/:id/ready.
# Придумывает человек, значение должно совпадать у api и у воркера. Не задан (или
# пустой) — маршрут закрыт для всех, любой стук получает 401, и пуш «ролик готов»
# не уходит.
# INTERNAL_WORKER_TOKEN=

# Где лежит schema.sql соседнего montage — оттуда берётся таблица jobs.
# По умолчанию ../montage/schema.sql, то есть сабмодуль рядом.
# MONTAGE_SCHEMA_SQL=../montage/schema.sql

# Our client ids at Apple and Google — the `aud` an id token must carry.
# Unset means the provider is off: /auth/apple and /auth/google answer 501.
# APPLE_CLIENT_ID=com.example.remember
# GOOGLE_CLIENT_ID=000000000000-xxxxxxxx.apps.googleusercontent.com
